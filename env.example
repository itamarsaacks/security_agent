# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# Choose ONE: "openai" or "anthropic"
# OpenAI is cheaper (~$0.10/run), Anthropic is more capable
LLM_PROVIDER=openai

# Model selection (optional - uses defaults if not specified)
# Cheap: gpt-4o-mini (~$0.10/run), claude-3-5-haiku-20241022
# Smart: gpt-4o (~$0.30/run), claude-3-5-sonnet-20241022 (~$0.50/run)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ==============================================================================
# API Keys (at least one LLM provider required)
# ==============================================================================
# Get OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Get Anthropic key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ==============================================================================
# PortSwigger Lab Access (REQUIRED)
# ==============================================================================
# Create free account at: https://portswigger.net/users/register
PORTSWIGGER_EMAIL=your-email@example.com
PORTSWIGGER_PASSWORD=your-password

# ==============================================================================
# Optional: Web Search
# ==============================================================================
# Get Tavily key from: https://tavily.com/
# Only needed if agent needs to search for SQL syntax
TAVILY_API_KEY=tvly-...

# ==============================================================================
# Optional: Tracing and Evaluation
# ==============================================================================
# Get LangSmith key from: https://smith.langchain.com/
# Useful for debugging and seeing what the agent is doing
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=security_agent
