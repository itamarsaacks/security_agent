# LLM Provider - choose "anthropic" or "openai"
LLM_PROVIDER=openai

# Model selection (optional - defaults shown)
# Cheap options: gpt-4o-mini (~$0.02/run), claude-3-haiku-20240307
# Smart options: gpt-4o (~$0.20/run), claude-sonnet-4-20250514 (~$0.50/run)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-haiku-20240307

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Web Search (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# Evaluation/Tracing (LangSmith)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=deep-agents-from-scratch

# PortSwigger Lab Access
PORTSWIGGER_EMAIL=your_email
PORTSWIGGER_PASSWORD=your_password
